# Luna 5.6 / OpenAI-Compatible API Configuration
LUNA_API_KEY="MY_LUNA_API_KEY"
LUNA_API_BASE_URL="https://api.openai.com/v1"
LUNA_MODEL_NAME="luna-5.6"

# GEMINI_API_KEY: Fallback Gemini AI API calls (Server & Serverless functions)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional client-side API key for static Vercel deployments
VITE_LUNA_API_KEY=""
VITE_GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"


